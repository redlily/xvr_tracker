    <string name="launch_title" translatable="false">CamTra</string>
    <string name="launch_subtitle_1" translatable="false">Make VRChat More Fun!</string>
    <string name="launch_subtitle_2" translatable="false">Full body tracking made simple for everyone!</string>
    <string name="onboarding_welcome_title">Welcome to CamTra!</string>
    <string name="onboarding_welcome_subtitle">Experience FBT (full-body tracking) in VRChat with CamTra!</string>
    <string name="onboarding_welcome_body">This app uses your smartphone\'s camera to analyze your head, torso, arms, and legs movements and sends the data to VRChat, enabling you to experience full-body tracking (FBT).</string>
    <string name="onboarding_ask_user_height_title">Please enter your height.</string>
    <string name="onboarding_ask_user_height_subtitle">Please enter your height for better camera-based pose tracking.</string>
    <string name="onboarding_ask_user_height_body">CamTra uses AI to analyze your pose from camera footage and sends that data as tracking data to VRChat.\nYour body measurements are needed to help the AI\'s data analysis and produce more accurate tracking data.</string>
    <string name="onboarding_ask_machine_ip_address_title">Please enter the IP address</string>
    <string name="onboarding_ask_machine_ip_address_subtitle">Please enter the IP address of the machine running VRChat.</string>
    <string name="onboarding_ask_machine_ip_address_body">CamTra sends tracking data to VRChat via OSC (Open Sound Control).\nPlease enter the IP address of the machine running VRChat.</string>
    <string name="onboarding_how_to_enable_osc_title">Enable OSC in VRChat</string>
    <string name="onboarding_how_to_enable_osc_subtitle">Enable OSC to receive tracking data from CamTra.</string>
    <string name="onboarding_how_to_enable_osc_body_1">Open menu.</string>
    <string name="onboarding_how_to_enable_osc_body_2">Open Settings.</string>
    <string name="onboarding_how_to_enable_osc_body_3">Open Options.</string>
    <string name="onboarding_how_to_enable_osc_body_4">Enable OSC.</string>
    <string name="onboarding_how_to_enable_osc_body_5">Restart VRChat. (if the \"Calibration\" option does not appear when you open the menu)</string>
    <string name="onboarding_how_to_enable_osc_body_6">Complete.</string>
    <string name="onboarding_how_to_calibration_tracker_title">Please perform calibration in VRChat.</string>
    <string name="onboarding_how_to_calibration_tracker_subtitle">Calibrate to make tracking data from CamTra apply to your avatar.</string>
    <string name="onboarding_how_to_test_osc_connection_title">Test data communication between app and VRChat</string>
    <string name="onboarding_how_to_test_osc_connection_subtitle">Check if tracking data can be sent and received between the app and VRChat.</string>
    <string name="onboarding_how_to_test_osc_connection_body_1">Launch tracker.</string>
    <string name="onboarding_how_to_test_osc_connection_body_2">Open Expression menu.</string>
    <string name="onboarding_how_to_test_osc_connection_body_3">Select Option.</string>
    <string name="onboarding_how_to_test_osc_connection_body_4">Select OSC.</string>
    <string name="onboarding_how_to_test_osc_connection_body_5">Select Debug.</string>
    <string name="onboarding_how_to_test_osc_connection_body_6">Please check in the displayed debug console whether data from the app is being received, as shown in the example image.</string>
    <string name="onboarding_how_to_calibration_tracker_body_1">Launch tracker.</string>
    <string name="onboarding_how_to_calibration_tracker_body_2">Open menu.</string>
    <string name="onboarding_how_to_calibration_tracker_body_3">Open calibration.</string>
    <string name="onboarding_how_to_calibration_tracker_body_4">You\'ll see a T-pose avatar in front of you. Match that pose.\nIK points will show up, so adjust your body parts to match those points.</string>
    <string name="onboarding_how_to_calibration_tracker_body_5">Pull both controller triggers.</string>
    <string name="onboarding_how_to_calibration_tracker_body_6">Complete.</string>
    <string name="onboarding_complete_title">That\'s it! Tutorial complete!</string>
    <string name="onboarding_complete_subtitle">Now enjoy FBT with CamTra!</string>
    <string name="onboarding_complete_body">You can revisit this tutorial from Settings → Other → Tutorial.</string>
