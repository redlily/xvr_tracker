    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our app requires camera access to analyze your pose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーのポーズを解析するためにカメラへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 자세를 분석하려면 카메라 접근 권한이 필요합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們的應用程式需要存取相機以分析您的姿勢。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們的應用程式需要存取相機以分析您的姿勢。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our app requires local network access to share body tracking data with other devices such as VR headsets."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRヘッドセットなどの他のデバイスとボディトラッキングデータを共有するために、ローカルネットワークへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 VR 헤드셋과 같은 다른 기기와 신체 추적 데이터를 공유하려면 로컬 네트워크 접근 권한이 필요합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們的應用程式需要存取區域網路以與VR頭戴式裝置等其他裝置共用身體追蹤資料。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們的應用程式需要存取區域網路以與VR頭戴式裝置等其他裝置共用身體追蹤資料。"
          }
        }
      }
    }
  },
  "version" : "1.0"
