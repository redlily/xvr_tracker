    "onboarding_welcome_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app uses your smartphone's camera to analyze your head, torso, arms, and legs movements and sends the data to VRChat, enabling you to experience full-body tracking (FBT)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリはスマートフォンのカメラを使用して頭、胴体、腕、足の動きを解析し、そのデータをVRChatに送信することでフルトラ（フルボディートラッキング）を体験することができるアプリです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 스마트폰의 카메라를 사용하여 머리, 몸통, 팔, 다리의 움직임을 분석하고 VRChat에 데이터를 전송하여 전체 신체 추적(FBT)을 경험할 수 있게 해주는 앱입니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此應用程式使用您智慧型手機的相機來分析您的頭部、軀幹、手臂和腿部動作，並將資料發送到VRChat，讓您體驗全身追蹤（FBT）。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此應用程式使用您智慧型手機的相機來分析您的頭部、軀幹、手臂和腿部動作，並將資料發送到VRChat，讓您體驗全身追蹤（FBT）。"
          }
        }
      }
    },
    "onboarding_welcome_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experience full-body tracking (FBT) in VRChat with CamTra!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
