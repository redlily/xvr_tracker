    "onboarding_ask_user_height_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CamTra uses AI to analyze your pose from camera footage and sends that data as tracking data to VRChat.\nYour body measurements are needed to help the AI's data analysis and produce more accurate tracking data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カムトラではあなたのポーズをカメラからの映像をAIにより推定し、そのデータをトラッキングデータとしてVRChatに送信します。\nそのAIによるデータの推定を補助しより正確なトラッキングデータの生成のためにあなたの身体の寸法が必要になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캠트라는 AI를 사용하여 카메라 영상에서 포즈를 분석하고 해당 데이터를 추적 데이터로 VRChat에 전송합니다.\nAI의 데이터 분석을 돕고 더 정확한 추적 데이터를 생성하기 위해 신체 측정값이 필요합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡姆拉使用AI來分析您從相機畫面中的姿勢，並將該資料作為追蹤資料發送到VRChat。\n需要您的身體測量值來協助AI的資料分析並產生更準確的追蹤資料。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡姆拉使用AI來分析您從相機畫面中的姿勢，並將該資料作為追蹤資料發送到VRChat。\n需要您的身體測量值來協助AI的資料分析並產生更準確的追蹤資料。"
          }
        }
      }
    },
