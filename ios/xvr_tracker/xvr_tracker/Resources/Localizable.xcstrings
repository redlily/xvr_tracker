    "camera_tracker_external_host_specified_dialog_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The IP address or domain configured as the connection destination to VRChat is set to a value outside the local network, such as a router."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRChatへの接続先として設定されているIPアドレス、またはドメインがルーター等のローカルネットワーク外の値が設定されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRChat 연결 대상으로 설정된 IP 주소 또는 도메인이 라우터 등 로컬 네트워크 외부 값으로 설정되어 있습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定為VRChat連線目標的IP位址或網域名稱已設定為本地網路外的值，例如路由器。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定為VRChat連線目標的IP位址或網域名稱已設定為本地網路外的值，例如路由器。"
          }
        }
      }
    },
