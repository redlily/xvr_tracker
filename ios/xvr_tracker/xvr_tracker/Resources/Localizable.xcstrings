    "camera_tracker_local_network_access_not_permitted_dialog_description_ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local network access is not permitted for the app. Please enable local network access from Settings > Privacy & Security > Local Network > CamTra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリにルーター等のローカルネットワークへのアクセスが許可されていません。設定 -> プライバシーとセキュリティ -> ローカルネットワーク -> カムトラ からローカルネットワークへのアクセスを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에 라우터 등의 로컬 네트워크 액세스가 허용되지 않습니다. 설정 > 개인정보 보호 및 보안 > 로컬 네트워크 > CamTra에서 로컬 네트워크 액세스를 활성화하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不允許應用程式存取本地網路（如路由器）。請在設定 > 隱私權與安全性 > 本地網路 > CamTra中啟用本地網路存取。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不允許應用程式存取本地網路（如路由器）。請在設定 > 隱私權與安全性 > 本地網路 > CamTra中啟用本地網路存取。"
          }
        }
      }
    },
