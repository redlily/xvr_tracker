    "vrc_connection_settings_sending_port_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When using this with VRChat, the port number is typically set to 9000. If you plan to use the tracking data with other tools or applications, please specify the port number accordingly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRChatで使用する際は通常、ポート番号は9000番になります。VRChat以外のその他のツール等でデータを使用する場合は値を設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRChat과 함께 사용할 때는 일반적으로 포트 번호가 9000으로 설정됩니다. 다른 도구나 애플리케이션에서 추적 데이터를 사용할 계획이라면 그에 따라 포트 번호를 지정하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與VRChat一起使用時，埠號通常設定為9000。如果您計劃在其他工具或應用程式中使用追蹤資料，請相應地指定埠號。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與VRChat一起使用時，埠號通常設定為9000。如果您計劃在其他工具或應用程式中使用追蹤資料，請相應地指定埠號。"
          }
        }
      }
    },
