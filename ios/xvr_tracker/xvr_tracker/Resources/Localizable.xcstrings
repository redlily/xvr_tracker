    "onboarding_how_to_calibration_tracker_body_4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll see a T-pose avatar in front of you. Match that pose.\nIK points will show up, so adjust your body parts to match those points."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目の前に使用しているT字ポーズのアバターが表示されるので同じポーズをとってください。\nこのときIKポイントが表示されるので各部位にそのポイントが合うように調整してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞에 T자 포즈의 아바타가 보입니다. 그 포즈를 맞춥니다.\nIK 포인트가 표시되므로 해당 포인트에 맞게 신체 부위를 조정합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您會看到一個T字姿勢的虛擬化身在您面前。請配合該姿勢。\nIK點會顯示，請調整您的身體部位以配合這些點。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您會看到一個T字姿勢的虛擬化身在您面前。請配合該姿勢。\nIK點會顯示，請調整您的身體部位以配合這些點。"
          }
        }
      }
    },
