    "camera_tracker_invalid_ip_address_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An IP address that cannot send body tracking data on the local network your device is connected to is configured. Please set a valid IP address in \"Settings > VRChat Connection > Destination IP\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末が接続されているローカルネットワークでボディートラッキングデータを送信できないIPアドレスが設定されています。「設定 > VRChatへの接続 > 接続先のIP」で有効なIPアドレスを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기가 연결된 로컬 네트워크에서 신체 추적 데이터를 전송할 수 없는 IP 주소가 설정되어 있습니다. \"설정 > VRChat 연결 > 대상 IP\"에서 유효한 IP 주소를 설정하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已設定一個無法在您裝置連接的本地網路上傳送身體追蹤資料的IP位址。請在「設定 > VRChat連線 > 目標IP」中設定有效的IP位址。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
