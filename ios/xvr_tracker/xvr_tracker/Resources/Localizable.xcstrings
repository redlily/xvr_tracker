    "onboarding_ask_machine_ip_address_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address of the device running VRChat is needed to send tracking data to it.\nFor VR devices (platform version), please find the VR device's IP address. For PC version, please find the PC's IP address."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カムトラはOSC（Open Sound Control）経由でトラッキングデータをVRChatに送信します。\nVRChatを起動している機器のIPアドレスを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캠트라는 OSC(Open Sound Control)를 통해 추적 데이터를 VRChat에 전송합니다.\nVRChat이 실행 중인 기기의 IP 주소를 입력하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要執行VRChat的裝置位址才能發送追蹤資料。\n對於VR裝置（平台版本），請找到VR裝置的IP位址。對於PC版本，請找到PC的IP位址。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要執行VRChat的裝置位址才能發送追蹤資料。\n對於VR裝置（平台版本），請找到VR裝置的IP位址。對於PC版本，請找到PC的IP位址。"
          }
        }
      }
    },
    "onboarding_ask_machine_ip_address_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please enter the IP address of the device running VRChat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRChatを起動している機器のIPアドレスを教えて下さい"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRChat이 실행 중인 기기의 IP 주소를 입력하세요."
