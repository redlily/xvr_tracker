    "pose_tracker_advanced_settings_stabilizing_coefficients_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings for stabilization coefficients of tracking data\nHigher values reduce noise but increase response time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラッキングデータの安定化の係数の設定\n数値が大きいほどノイズが軽減されますが応答速度が低下します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추적 데이터의 안정화 계수 설정\n값이 높을수록 노이즈가 줄어들지만 응답 시간이 증가합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追蹤資料穩定化係數的設定\n數值越大，噪音越少，但響應速度會降低。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追蹤資料穩定化係數的設定\n數值越大，噪音越少，但響應速度會降低。"
          }
        }
      }
    },
